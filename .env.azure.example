# ========================================
# AZURE DEPLOYMENT - ENVIRONMENT VARIABLES
# ========================================
# 
# IMPORTANT: This is a template file. Do NOT add actual credentials here.
# Copy this file to .env.azure and fill in your actual values.
# The .env.azure file is gitignored and will not be committed.
#
# Setup Instructions:
# 1. Copy this file: cp .env.azure.example .env.azure
# 2. Fill in your actual credentials in .env.azure
# 3. Load the environment: source .env.azure (Linux/Mac) or use Import-Csv in PowerShell
#
# ========================================

# Azure Container Registry (DEV.AF Tenant)
AZURE_ACR_USERNAME_DEV=acraz2003cah25oct
AZURE_ACR_PASSWORD_DEV=your_acr_password_here
AZURE_ACR_SERVER_DEV=acraz2003cah25oct.azurecr.io

# Azure Container Registry (NEUMAN and ESSER Tenant)
AZURE_ACR_USERNAME_NEA=acraz2003ou17juli
AZURE_ACR_PASSWORD_NEA=your_acr_password_here
AZURE_ACR_SERVER_NEA=acraz2003ou17juli.azurecr.io

# Azure Subscriptions
AZURE_SUBSCRIPTION_ID_DEV=9b7860bb-19cc-428f-ad31-3e38fd5d4d9c
AZURE_SUBSCRIPTION_ID_NEA=9e89f2d0-f39d-4ade-aa60-23ee14a02deb

# Azure Key Vault (Recommended for Production)
# Set this to use Azure Key Vault for credential storage
AZURE_KEY_VAULT_NAME=your-keyvault-name

# ========================================
# AUTHENTICATION METHOD PRIORITY
# ========================================
# Scripts will try authentication in this order:
# 1. Azure Key Vault (if AZURE_KEY_VAULT_NAME is set)
# 2. Environment Variables (these settings)
# 3. Azure CLI authentication (az acr login)
#
# Recommendation: Use Azure Key Vault in production
# ========================================

# Usage Examples:
# 
# PowerShell:
# -----------
# $env:AZURE_ACR_USERNAME_DEV="acraz2003cah25oct"
# $env:AZURE_ACR_PASSWORD_DEV="your_password"
# 
# Or load from file:
# Get-Content .env.azure | ForEach-Object {
#     if ($_ -match '^([^#][^=]+)=(.+)$') {
#         [Environment]::SetEnvironmentVariable($matches[1], $matches[2], "Process")
#     }
# }
#
# Bash/Linux:
# -----------
# export AZURE_ACR_USERNAME_DEV="acraz2003cah25oct"
# export AZURE_ACR_PASSWORD_DEV="your_password"
#
# Or load from file:
# source .env.azure
